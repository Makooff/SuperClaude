#!/usr/bin/env bash
# sc-mcp — allume/éteint les MCP lourds de SuperClaude Lite.
# Un MCP enregistré charge ses schémas d'outils dans CHAQUE session : on ne l'allume
# que pour la période où on en a besoin.
set -euo pipefail

usage() {
  cat <<'USAGE'
sc-mcp <magic|playwright|context7|all> on|off
sc-mcp list

  magic       composants UI 21st.dev  (clé: $MAGIC_API_KEY, sinon demandée)
  playwright  browser / E2E / screenshots
  context7    docs live d'une lib
USAGE
  exit 1
}

[ $# -ge 1 ] || usage
name="$1"

if [ "$name" = "list" ]; then
  claude mcp list
  exit 0
fi

[ $# -eq 2 ] || usage
action="$2"

add_one() {
  case "$1" in
    magic)
      key="${MAGIC_API_KEY:-}"
      if [ -z "$key" ] && [ -t 0 ]; then
        printf 'Clé API 21st.dev Magic (Entrée pour ignorer) : '
        read -r key || true
      fi
      if [ -n "$key" ]; then
        claude mcp add -s user magic -e "API_KEY=$key" -- npx -y @21st-dev/magic@latest
      else
        claude mcp add -s user magic -- npx -y @21st-dev/magic@latest
      fi ;;
    playwright) claude mcp add -s user playwright -- npx @playwright/mcp@latest ;;
    context7)   claude mcp add -s user context7   -- npx -y @upstash/context7-mcp ;;
    *) echo "MCP inconnu : $1" >&2; exit 1 ;;
  esac
}

targets=("$name")
[ "$name" = "all" ] && targets=(magic playwright context7)

for t in "${targets[@]}"; do
  case "$action" in
    on)  add_one "$t" && echo "✓ $t activé" ;;
    off) claude mcp remove -s user "$t" >/dev/null 2>&1 && echo "✓ $t désactivé" || echo "! $t n'était pas actif" ;;
    *)   usage ;;
  esac
done

echo "Redémarre Claude Code pour appliquer."
