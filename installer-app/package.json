{
  "name": "superclaude-installer",
  "version": "1.0.0",
  "description": "SuperClaude Installer",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac --win",
    "build-win": "electron-builder --win",
    "build-mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.superclaude.installer",
    "productName": "SuperClaude Installer",
    "directories": { "output": "dist" },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "installerLanguages": ["fr_FR", "en_US"]
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
